# Exemplo de variáveis de ambiente da API. NÃO contenha segredos reais.
ASPNETCORE_ENVIRONMENT=Development

# Produção: mesmo banco do PDVStore (SQL Server)
Database__Provider=SqlServer
ConnectionStrings__DefaultConnection="Server=(localdb)\\MSSQLLocalDB;Database=PDV_StoreDB;Trusted_Connection=True;"

# Obrigatória: no mínimo 32 caracteres. Gere com: openssl rand -base64 48
Jwt__Key=GERE-UMA-CHAVE-ALEATORIA-COM-32-CARACTERES-OU-MAIS
Jwt__Issuer=PDVStore.Api
Jwt__Audience=PDVStore.Web
Jwt__ExpirationMinutes=480

Cors__AllowedOrigins__0=http://localhost:5173

# Somente desenvolvimento local sem SQL Server:
# Database__Provider=Sqlite
# Database__EnsureCreatedForDevelopment=true
# ConnectionStrings__DefaultConnection=Data Source=pdvstore-dev.db
